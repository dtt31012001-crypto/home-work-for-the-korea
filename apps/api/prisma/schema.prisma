// TH – Tiếng Hàn · Identity & Access + Organization (lát cắt D-B17)
// Quy ước: bảng/cột snake_case, thời gian timestamptz (UTC), khóa UUIDv7.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DEACTIVATED
}

enum IdentityType {
  PHONE
  EMAIL
}

enum Role {
  SUPER_ADMIN
  CENTER_ADMIN
  TEACHER
  STUDENT
  /// Gán theo trung tâm khi trung tâm tạo tài khoản phụ huynh. Quyền xem dữ liệu con chỉ đến từ guardian_link còn hiệu lực.
  PARENT
}

enum SessionPolicy {
  ADMIN
  TEACHER
  LEARNER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id              String             @id @default(uuid(7)) @db.Uuid
  code            String             @unique
  name            String
  status          OrganizationStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?            @map("created_by") @db.Uuid
  roleAssignments RoleAssignment[]

  @@map("organization")
}

model User {
  id               String              @id @default(uuid(7)) @db.Uuid
  displayName      String              @map("display_name")
  status           UserStatus          @default(ACTIVE)
  /// Tăng khi khóa tài khoản / đổi hoặc đặt lại mật khẩu → mọi access token cũ mất hiệu lực ngay
  tokenVersion     Int                 @default(0) @map("token_version")
  failedLoginCount Int                 @default(0) @map("failed_login_count")
  lockedUntil      DateTime?           @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime?           @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  identities       UserIdentity[]
  credential       PasswordCredential?
  sessions         Session[]
  roleAssignments  RoleAssignment[]

  @@map("app_user")
}

model UserIdentity {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  type       IdentityType
  /// Giá trị đã chuẩn hóa: SĐT E.164, email chữ thường
  value      String
  verifiedAt DateTime?    @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User         @relation(fields: [userId], references: [id])

  @@unique([type, value])
  @@index([userId])
  @@map("user_identity")
}

model PasswordCredential {
  userId        String    @id @map("user_id") @db.Uuid
  hash          String
  /// true với mật khẩu tạm do trung tâm cấp: bắt buộc đổi ở lần đăng nhập đầu
  mustChange    Boolean   @map("must_change")
  tempExpiresAt DateTime? @map("temp_expires_at") @db.Timestamptz(6)
  changedAt     DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id])

  @@map("password_credential")
}

model Session {
  id              String        @id @default(uuid(7)) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  /// SHA-256 của refresh token; token gốc chỉ nằm trong cookie httpOnly
  tokenHash       String        @unique @map("token_hash")
  /// Chuỗi xoay vòng: phát hiện dùng lại refresh token cũ → thu hồi cả chuỗi
  familyId        String        @map("family_id") @db.Uuid
  /// Thời điểm đăng nhập của chuỗi phiên – để tính thời hạn tối đa
  familyStartedAt DateTime      @default(now()) @map("family_started_at") @db.Timestamptz(6)
  /// Thời hạn tối đa của cả chuỗi (không gia hạn qua làm mới)
  familyExpiresAt DateTime      @default(now()) @map("family_expires_at") @db.Timestamptz(6)
  policy          SessionPolicy @default(LEARNER)
  /// Hết hạn nếu không làm mới (idle); luôn ≤ family_expires_at
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedReason   String?       @map("revoked_reason")
  replacedById    String?       @map("replaced_by_id") @db.Uuid
  userAgent       String?       @map("user_agent")
  ip              String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("session")
}

model RoleAssignment {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  role           Role
  /// NULL chỉ với SUPER_ADMIN (phạm vi nền tảng)
  organizationId String?       @map("organization_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    String?       @map("created_by") @db.Uuid
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(6)
  user           User          @relation(fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@map("role_assignment")
}

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  at             DateTime @default(now()) @db.Timestamptz(6)
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  data           Json?
  ip             String?
  requestId      String?  @map("request_id")

  @@index([organizationId, at])
  @@index([actorUserId, at])
  @@map("audit_log")
}
