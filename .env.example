# Sao chép thành apps/api/.env khi phát triển. Giá trị dưới đây chỉ là mẫu.
DATABASE_URL=postgresql://th:th_dev_only@localhost:5432/th_dev
# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# true khi chạy sau HTTPS (production/staging)
COOKIE_SECURE=false
API_PORT=4000
