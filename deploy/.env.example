# Mẫu cho deploy/.env.staging và deploy/.env.production (KHÔNG commit file thật).
# Mỗi môi trường dùng mật khẩu/khóa riêng, sinh bằng: openssl rand -base64 36
COMPOSE_PROJECT_NAME=th-staging
IMAGE_TAG=local
SITE_ADDRESS=staging.example.vn
POSTGRES_DB=th
POSTGRES_OWNER_USER=th_owner
POSTGRES_OWNER_PASSWORD=change-me
APP_DB_USER=th_app
APP_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long
COOKIE_SECURE=true
BACKUP_RETENTION_DAYS=14
BACKUP_HOST_DIR=/srv/th-staging/backups
